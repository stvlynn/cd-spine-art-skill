{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Badge preset catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["presets"],
  "properties": {
    "$schema": { "type": "string" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/preset" }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "group", "theme"],
      "properties": {
        "slug": { "$ref": "#/definitions/name" },
        "group": { "enum": ["ai", "stack"] },
        "theme": {
          "type": "string",
          "minLength": 1,
          "description": "A theme ID from packages/spine/src/themes.ts, checked during generation."
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 40,
          "description": "Simple Icons slug. Defaults to the preset slug."
        },
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Display title. Defaults to the icon title."
        },
        "paint": { "enum": ["paper", "accent"] },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        }
      }
    }
  }
}
