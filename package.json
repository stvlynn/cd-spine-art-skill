{
  "name": "spines",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "deploy": "pnpm --filter @repo/web run deploy",
    "test": "pnpm presets && vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fonts": "pnpm --filter @repo/spine fonts",
    "presets": "pnpm --filter @repo/web presets",
    "art": "pnpm --filter @repo/web art"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
